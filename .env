SOME_CONFIG=config
DATABASE_NAME=TESTMS
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PSWD=ENNBA
DATABASE_PORT=1021
MS_PORT=3000
EXTERNAL_SERVICE_URL=http://localhost:3001

# Background workers
WORKER_SHUTDOWN_TIMEOUT_SECS=8
# DEMO_HEARTBEAT_FAIL_AFTER=3
# DEMO_STUCK_WORKER=true

# Discord bot (required: the app exits without a token)
# Never commit a real token: this file is tracked in git. Set DISCORD_TOKEN in your shell
# or IDE run configuration instead. The tests use a fake gateway.
# DISCORD_TOKEN=...
# DISCORD_GUILD_ID=123456789012345678   (optional: a test server, commands show up at once)
# DISCORD_MAX_CONCURRENT=32   (optional: interactions handled at the same time)
