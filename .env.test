SOME_CONFIG=config
DATABASE_NAME=DEV_ENVIRONMENT
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PSWD=ENNBA
DATABASE_PORT=1021
MS_PORT=0
RUST_LOG=debug

# Background workers
WORKER_SHUTDOWN_TIMEOUT_SECS=8
# DEMO_HEARTBEAT_FAIL_AFTER=3
# DEMO_STUCK_WORKER=true

# Telegram bot (required: the app exits without a token)
# Never commit a real token: this file is tracked in git. Set TELEGRAM_BOT_TOKEN
# in your shell or IDE run configuration instead. The tests use a fake Telegram.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_API_URL=https://api.telegram.org
